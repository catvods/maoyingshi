// 柔彩气泡：胖轮播 + 大圆角 + 柔和马卡龙色。
// 教学重点：大 viewport 卡片、径向渐变、圆形按钮、网格/横图/无图列表切换。
import core.widgets;
import peek.home;

widget Hero = GestureDetector(
  onTap: event "openRecommend" { index: args.item.index },
  child: Container(
    margin: [ 10.0 ],
    decoration: {
      type: "box",
      color: 0xFFFFF7FB,
      borderRadius: [ { x: 34.0 } ],
      border: [ { color: 0xFFFFC3DD, width: 2.0 } ],
      boxShadow: [ { color: 0x55F08BB8, blurRadius: 28.0, offset: { x: 0.0, y: 10.0 } } ],
    },
    child: ClipRRect(
      borderRadius: [ { x: 32.0 } ],
      child: Stack(
        fit: "expand",
        children: [
          T4Image(url: args.item.pic),
          Container(
            decoration: {
              type: "box",
              gradient: {
                type: "radial",
                center: { x: -0.8, y: 0.8 },
                radius: 1.2,
                colors: [ 0xEEFFF2F8, 0x88FFD2E5, 0x00000000 ],
              },
            },
          ),
          Align(
            alignment: { x: -1.0, y: 1.0 },
            child: Container(
              width: 360.0,
              padding: [ 28.0 ],
              child: Column(
                mainAxisSize: "min",
                crossAxisAlignment: "start",
                children: [
                  Text(
                    text: args.item.name,
                    maxLines: 2,
                    overflow: "ellipsis",
                    style: {
                      color: 0xFF64344D,
                      fontSize: 28.0,
                      fontWeight: "w900",
                    },
                  ),
                  Padding(
                    padding: [ 0.0, 8.0, 0.0, 0.0 ],
                    child: Text(
                      text: args.item.remarks,
                      style: {
                        color: 0xFF9B607E,
                        fontSize: 12.0,
                      },
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    ),
  ),
);

widget Bubble = GestureDetector(
  onTap: event "selectType" { typeId: args.item.typeId },
  child: Container(
    margin: [ 0.0, 12.0, 9.0, 5.0 ],
    padding: [ 15.0, 7.0 ],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      color: switch args.item.selected {
        true: 0xFFFFA9CD,
        false: 0xFFFFFFFF,
      },
      borderRadius: [ { x: 20.0 } ],
      border: [ { color: switch args.item.selected {
        true: 0xFFFF7DB4,
        false: 0xFFFFD3E5,
      }, width: 1.0 } ],
      boxShadow: switch args.item.selected {
        true: [ { color: 0x55FF75AE, blurRadius: 13.0 } ],
        false: [],
      },
    },
    child: Text(
      text: args.item.typeName,
      style: {
        color: switch args.item.selected {
          true: 0xFF5B2841,
          false: 0xFF8A6074,
        },
        fontSize: 13.0,
        fontWeight: "w700",
      },
    ),
  ),
);

widget TinyToolButton = GestureDetector(onTap: args.action, child: Container(width: 24.0, height: 28.0, alignment: { x: 0.0, y: 0.0 }, child: Icon(icon: args.icon, fontFamily: "MaterialIcons", size: 17.0, color: 0xFFB65E88)));
widget Tool = GestureDetector(
  onTap: args.action,
  child: Container(
    width: 40.0,
    height: 40.0,
    margin: [ 2.0 ],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      color: 0xFFFFFFFF,
      borderRadius: [ { x: 20.0 } ],
      border: [ { color: 0xFFFFC9DF, width: 1.0 } ],
    },
    child: Icon(
      icon: args.icon,
      fontFamily: "MaterialIcons",
      size: 19.0,
      color: 0xFFB65E88,
    ),
  ),
);

widget FilterOption = GestureDetector(
  onTap: event "selectFilter" { key: args.item.filterKey, value: args.item.value },
  child: Container(
    margin: [ 0.0, 8.0, 7.0, 8.0 ],
    padding: [ 10.0, 2.0 ],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      color: switch args.item.selected {
        true: 0xFFFF82B7,
        false: 0xFFFFFFFF,
      },
      borderRadius: [ { x: 14.0 } ],
      border: [ { color: 0xFFFFC9DF, width: 1.0 } ],
    },
    child: Text(
      text: args.item.name,
      style: {
        color: switch args.item.selected {
          true: 0xFFFFFFFF,
          false: 0xFF8F5571,
        },
        fontSize: 10.0,
        fontWeight: "w700",
      },
    ),
  ),
);

widget FilterRow = Row(
  children: [
    Expanded(
      child: ListView(
        scrollDirection: "horizontal",
        children: [
          ...for option in args.group.options:
            FilterOption(item: option),
        ],
      ),
    ),
    switch args.group.canExpand {
      true: Tool(icon: data.home.icons.expand, action: event "showFilterPicker" { key: args.group.key }),
      false: SizedBoxShrink(),
    },
  ],
);

widget CandyCard = GestureDetector(
  onTap: event "openItem" { index: args.item.index },
  onLongPress: event "longPressItem" { index: args.item.index },
  child: Container(
    decoration: {
      type: "box",
      gradient: {
        type: "linear",
        begin: { x: -1.0, y: -1.0 },
        end: { x: 1.0, y: 1.0 },
        colors: [ 0xFFFFFFFF, 0xFFFFF0F7 ],
      },
      borderRadius: [ { x: 22.0 } ],
      border: [ { color: 0xFFFFD2E5, width: 1.0 } ],
      boxShadow: [ { color: 0x33E784AF, blurRadius: 16.0, offset: { x: 0.0, y: 7.0 } } ],
    },
    child: ClipRRect(
      borderRadius: [ { x: 22.0 } ],
      child: Column(
        crossAxisAlignment: "start",
        children: [
          Expanded(child: T4Image(url: args.item.pic)),
          Padding(
            padding: [ 12.0, 10.0, 12.0, 3.0 ],
            child: Text(
              text: args.item.name,
              maxLines: 1,
              overflow: "ellipsis",
              style: {
                color: 0xFF61384D,
                fontSize: 14.0,
                fontWeight: "w800",
              },
            ),
          ),
          Padding(
            padding: [ 12.0, 2.0, 12.0, 11.0 ],
            child: Text(
              text: args.item.remarks,
              style: {
                color: 0xFFB36A8D,
                fontSize: 10.0,
              },
            ),
          ),
        ],
      ),
    ),
  ),
);

