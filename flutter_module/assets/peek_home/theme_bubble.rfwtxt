widget SectionBar = Container(
  color: 0x00000000,
  padding: switch data.home.gridColumns {
    3: [ 16.0, 8.0, 16.0, 10.0 ],
    default: [ 20.0, 5.0, 20.0, 8.0 ],
  },
  child: Row(
    children: [
      Expanded(
        child: SectionTitleSource(),
      ),
      Container(
        width: switch data.home.isLandscape {
          true: 312.0,
          false: 214.0,
        },
        height: 28.0,
        child: switch data.home.isLandscape {
          true: SectionActionsWide(),
          false: SectionActionsCompact(),
        },
      ),
    ],
  ),
);

widget Header = Container(
  color: 0xFFFFF5FA,
  child: Column(
    children: [
      Container(
        height: 54.0,
        padding: [ 14.0, 0.0 ],
        child: Row(
          children: [
            Expanded(
              child: ListView(
                scrollDirection: "horizontal",
                children: [
                  ...for item in data.home.classes:
                    Bubble(item: item),
                ],
              ),
            ),
          ],
        ),
      ),
      switch data.home.showFilters {
        true: Container(
          height: data.home.filterPanelHeight,
          margin: [ 14.0, 4.0, 14.0, 6.0 ],
          padding: [ 10.0, 4.0 ],
          decoration: {
            type: "box",
            color: 0xFFFFFFFF,
            borderRadius: [ { x: 18.0 } ],
            border: [ { color: 0xFFFFC9DF, width: 1.0 } ],
            boxShadow: [ { color: 0x22FF82B7, blurRadius: 14.0 } ],
          },
          child: ListView(
            children: [
              ...for group in data.home.filters:
                Container(
                  height: 39.0,
                  child: FilterRow(group: group),
                ),
            ],
          ),
        ),
        false: SizedBoxShrink(),
      },
    ],
  ),
);

widget root = Container(
  color: 0xFFFFF5FA,
  child: PeekStickyGrid(
    heroHeight: switch data.home.hasRecommend {
      true: 280.0,
      false: 0.0,
    },
    pinnedHeight: data.home.stickyHeaderHeight,
    sectionHeight: 64.0,
    crossAxisCount: switch data.home.displayStyle {
      "grid": data.home.gridColumns,
      "largeGrid": data.home.largeGridColumns,
      "banner": data.home.bannerColumns,
      "list": 1,
      "list2": 1,
      "textList": 1,
      "card": 1,
      default: data.home.gridColumns,
    },
    childAspectRatio: switch data.home.displayStyle {
      "grid": 0.60,
      "largeGrid": 0.60,
      "banner": 1.8,
      "list": data.home.wideListRatio,
      "list2": data.home.textListRatio,
      "textList": data.home.textListRatio,
      "card": data.home.wideListRatio,
      default: 0.60,
    },
    hero: switch data.home.hasRecommend {
      true: PeekCarousel(
        autoPlay: true,
        interval: 4800,
        viewportFraction: 0.82,
        activeColor: 0xFFFF7FB5,
        inactiveColor: 0x66CF91AC,
        children: [
          ...for item in data.home.home.recommend:
            Hero(item: item),
        ],
      ),
      false: SizedBoxShrink(),
    },
    pinnedHeader: Header(),
    sectionHeader: SectionBar(),
    empty: Center(
      child: Text(
        text: "这里还没有影片",
        style: { color: 0xFFB36A8D },
      ),
    ),
    children: [
      ...for item in data.home.items:
        Item(item: item),
    ],
  ),
);
