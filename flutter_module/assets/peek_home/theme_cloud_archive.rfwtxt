          text: [ data.home.totalLabel, " 部内容 · 点击站源名切换站源" ],
          maxLines: 1,
          overflow: "ellipsis",
          style: { color: 0xFF778291, fontSize: 10.0, letterSpacing: 0.4 },
        ),
      ),
    ],
  ),
);

