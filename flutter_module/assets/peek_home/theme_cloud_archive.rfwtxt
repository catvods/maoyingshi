          Expanded(
            child: Padding(
              padding: [ 10.0 ],
              child: Column(
                mainAxisSize: "min",
                crossAxisAlignment: "start",
                children: [
                  Text(
                    text: "EDITOR'S CHOICE",
                    style: { color: 0xFF39D8C7, fontSize: 8.0, fontWeight: "w900", letterSpacing: 1.4 },
                  ),
                  Padding(
                    padding: [ 0.0, 5.0, 0.0, 0.0 ],
                    child: Text(
                      text: args.item.name,
                      maxLines: 1,
                      overflow: "ellipsis",
                      style: { color: 0xFFFFFFFF, fontSize: 16.0, fontWeight: "w900", height: 1.05 },
                    ),
                  ),
                  switch args.item.remarks {
                    "": SizedBoxShrink(),
                    default: Padding(
                      padding: [ 0.0, 5.0, 0.0, 0.0 ],
                      child: Text(
                        text: args.item.remarks,
                        maxLines: 1,
                        overflow: "ellipsis",
                        style: { color: 0xFF909BA9, fontSize: 10.0 },
                      ),
                    ),
                  },
                ],
              ),
            ),
          ),
          Padding(
            padding: [ 14.0 ],
            child: Icon(
              icon: data.home.icons.open,
              fontFamily: "MaterialIcons",
              size: 21.0,
              color: 0xFFE9D7AA,
            ),
          ),
        ],
      ),
    ),
  ),
);

widget ThemeItem = switch data.home.displayStyle {
  "grid": PosterCard(item: args.item),
  "largeGrid": LargePosterCard(item: args.item),
  "banner": BannerCard(item: args.item),
  "list": ListCard(item: args.item),
  "list2": CompactCard(item: args.item),
  "textList": TextOnlyCard(item: args.item),
  "card": WideCollectionCard(item: args.item),
  default: PosterCard(item: args.item),
};

widget EmptyState = switch data.home.loading {
  true: Center(
    child: Text(
      text: "正在筛选今日片单…",
      style: { color: 0xFFE9D7AA, fontSize: 13.0, fontWeight: "w800" },
    ),
  ),
  false: switch data.home.errorMessage {
    "": Center(
      child: Text(
        text: "暂无可展示内容",
        style: { color: 0xFF7E8997, fontSize: 13.0 },
      ),
    ),
    default: GestureDetector(
      onTap: event "refresh" {},
      child: Center(
        child: Text(
          text: data.home.errorMessage,
          maxLines: 2,
          overflow: "ellipsis",
          style: { color: 0xFFE9D7AA, fontSize: 12.0 },
        ),
      ),
    ),
  },
};

widget root = Container(
  decoration: {
    type: "box",
    gradient: {
      type: "linear",
      begin: { x: -1.0, y: -1.0 },
      end: { x: 1.0, y: 1.0 },
      colors: [ 0xFF0A0D13, 0xFF07090E, 0xFF0B1017 ],
      stops: [ 0.0, 0.55, 1.0 ],
    },
  },
  child: AnimationDefaults(
    duration: 360,
    curve: "easeOutCubic",
    child: PeekStickyGrid(
      heroHeight: switch data.home.hasRecommend {
        true: switch data.home.gridColumns {
          3: 500.0,
          4: 520.0,
          5: 520.0,
          6: 520.0,
          default: 500.0,
        },
        false: 0.0,
      },
      pinnedHeight: data.home.stickyHeaderHeight,
      sectionHeight: 62.0,
      crossAxisCount: switch data.home.displayStyle {
        "grid": data.home.gridColumns,
        "largeGrid": data.home.largeGridColumns,
        "banner": 1,
        "list": 1,
        "list2": 1,
        "textList": 1,
        "card": 1,
        default: data.home.gridColumns,
      },
      childAspectRatio: switch data.home.displayStyle {
        "grid": 0.55,
        "largeGrid": 0.56,
        "banner": data.home.wideListRatio,
        "list": data.home.wideListRatio,
        "list2": data.home.textListRatio,
        "textList": data.home.textListRatio,
        "card": data.home.wideListRatio,
        default: 0.55,
      },
      mainAxisSpacing: 13.0,
      crossAxisSpacing: 11.0,
      horizontalPadding: 14.0,
      bottomPadding: 96.0,
      hero: switch data.home.hasRecommend {
        true: PeekCarousel(
          autoPlay: true,
          style: "stack",
          showIndicators: false,
          interval: 4200,
          viewportFraction: 1.0,
          stackScale: 0.84,
          stackOpacity: 0.56,
          stackOffset: 0.22,
          stackRotation: 0.025,
          activeColor: 0xFFE9D7AA,
          inactiveColor: 0x5539D8C7,
          children: [
            ...for item in data.home.home.recommend:
              HeroPoster(item: item),
          ],
        ),
        false: SizedBoxShrink(),
      },
      pinnedHeader: CategoryHeader(),
      sectionHeader: SectionBar(),
      empty: EmptyState(),
      children: [
        ...for item in data.home.items:
          ThemeItem(item: item),
      ],
    ),
  ),
);
