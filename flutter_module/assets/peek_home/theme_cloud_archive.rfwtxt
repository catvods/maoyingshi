// 云幕典藏：为竖版影视海报设计的高级感首页主题。
// 窄幅竖版轮播 + 暗金玻璃 + 当前卡片抬升动画。
// 工具按钮独立放在分类下方，与“为你推荐”位于同一行。
import core.widgets;
import peek.home;

widget HeroPoster = GestureDetector(
  onTap: event "openRecommend" { index: args.item.index },
  child: Center(
    child: AspectRatio(
      aspectRatio: 0.70,
      child: Container(
        margin: [ 7.0, 8.0 ],
        decoration: {
          type: "box",
          color: 0xFF10131A,
          borderRadius: [ { x: 22.0 } ],
          border: [ { color: 0x443D4654, width: 1.0 } ],
          boxShadow: [
            { color: 0x88000000, blurRadius: 28.0, offset: { x: 0.0, y: 16.0 }, spreadRadius: 1.0 },
          ],
        },
        child: ClipRRect(
          borderRadius: [ { x: 22.0 } ],
          child: T4Image(url: args.item.pic),
        ),
      ),
    ),
  ),
);

widget CategoryChip = GestureDetector(
  onTap: event "selectType" { typeId: args.item.typeId },
  child: Container(
    height: 42.0,
    margin: [ 0.0, 6.0, 8.0, 16.0 ],
    padding: [ 10.0, 0.0 ],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      gradient: switch args.item.selected {
        true: {
          type: "linear",
          begin: { x: -1.0, y: 0.0 },
          end: { x: 1.0, y: 0.0 },
          colors: [ 0xFFE9D7AA, 0xFFC5A968 ],
        },
        false: {
          type: "linear",
          colors: [ 0xFF171B24, 0xFF11151C ],
        },
      },
      borderRadius: [ { x: 16.0 } ],
      border: [
        {
          color: switch args.item.selected { true: 0xFFFFF3D2, false: 0xFF2B3340 },
          width: 1.0,
        },
      ],
      boxShadow: switch args.item.selected {
        true: [ { color: 0x33E9D7AA, blurRadius: 14.0 } ],
        false: [ { color: 0x22000000, blurRadius: 8.0 } ],
      },
    },
    child: Text(
      text: args.item.typeName,
      maxLines: 1,
      overflow: "ellipsis",
      style: {
        color: switch args.item.selected { true: 0xFF151820, false: 0xFF9AA3B1 },
        fontSize: 14.0,
        fontWeight: "w800",
        height: 1.0,
      },
    ),
  ),
);

widget ToolButton = GestureDetector(
  onTap: args.action,
  child: Container(
    width: 36.0,
    height: 36.0,
    margin: [ 5.0, 0.0, 0.0, 0.0 ],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      gradient: {
        type: "linear",
        begin: { x: -1.0, y: -1.0 },
        end: { x: 1.0, y: 1.0 },
        colors: [ 0xFF202632, 0xFF12161E ],
      },
      borderRadius: [ { x: 18.0 } ],
      border: [ { color: 0xFF343E4E, width: 1.0 } ],
      boxShadow: [ { color: 0x33000000, blurRadius: 10.0, offset: { x: 0.0, y: 5.0 } } ],
    },
    child: Icon(
      icon: args.icon,
      fontFamily: "MaterialIcons",
      size: 18.0,
      color: 0xFFE9D7AA,
    ),
  ),
);

widget FilterOption = GestureDetector(
  onTap: event "selectFilter" { key: args.item.filterKey, value: args.item.value },
  child: Container(
    margin: [ 0.0, 8.0, 7.0, 8.0 ],
    padding: [ 10.0, 2.0 ],
    decoration: {
      type: "box",
      color: switch args.item.selected { true: 0xFFE9D7AA, false: 0xFF171C25 },
      borderRadius: [ { x: 12.0 } ],
      border: [ { color: switch args.item.selected { true: 0xFFFFF2CC, false: 0xFF303947 }, width: 1.0 } ],
    },
    child: Text(
      text: args.item.name,
      maxLines: 1,
      overflow: "ellipsis",
      style: {
        color: switch args.item.selected { true: 0xFF13161C, false: 0xFFAEB6C2 },
        fontSize: 12.0,
        fontWeight: "w800",
      },
    ),
  ),
);

widget FilterRow = Row(
  children: [
    Container(
      width: 32.0,
      child: Text(
        text: args.group.name,
        maxLines: 1,
        overflow: "ellipsis",
        style: { color: 0xFFE9D7AA, fontSize: 12.0, fontWeight: "w800" },
      ),
    ),
    Expanded(
      child: ListView(
        scrollDirection: "horizontal",
        children: [
          ...for option in args.group.options:
            FilterOption(item: option),
        ],
      ),
    ),
    switch args.group.canExpand {
      true: ToolButton(
        icon: data.home.icons.expand,
        action: event "showFilterPicker" { key: args.group.key },
      ),
      false: SizedBoxShrink(),
    },
  ],
);

widget CategoryHeader = Container(
  decoration: {
    type: "box",
    color: 0xF2080B11,
    boxShadow: [ { color: 0x66000000, blurRadius: 16.0, offset: { x: 0.0, y: 8.0 } } ],
  },
  child: Column(
    children: [
      Container(
        height: 54.0,
        padding: [ 14.0, 0.0 ],
        child: ListView(
          scrollDirection: "horizontal",
          children: [
            ...for item in data.home.classes:
              CategoryChip(item: item),
          ],
        ),
      ),
      switch data.home.showFilters {
        true: Container(
          height: data.home.filterPanelHeight,
          margin: [ 14.0, 4.0, 14.0, 6.0 ],
          padding: [ 10.0, 4.0 ],
          decoration: {
            type: "box",
            gradient: {
              type: "linear",
              begin: { x: -1.0, y: -1.0 },
              end: { x: 1.0, y: 1.0 },
              colors: [ 0xF51A202A, 0xF510141B ],
            },
            borderRadius: [ { x: 16.0 } ],
            border: [ { color: 0xFF313B4A, width: 1.0 } ],
            boxShadow: [ { color: 0x332ED0C0, blurRadius: 18.0 } ],
          },
          child: ListView(
            children: [
              ...for group in data.home.filters:
                Container(height: 39.0, child: FilterRow(group: group)),
            ],
          ),
        ),
        false: SizedBoxShrink(),
      },
    ],
  ),
);

widget SectionTitleSource = GestureDetector(
  onTap: event "showSourcePicker" {},
  child: Column(
    mainAxisSize: "min",
    crossAxisAlignment: "start",
    children: [
      Text(
        text: data.home.source.name,
        maxLines: 1,
