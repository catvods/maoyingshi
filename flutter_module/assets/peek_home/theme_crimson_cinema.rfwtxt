// 赤焰影院：超高沉浸轮播 + 黑红影院风格。
// 教学重点：大面积主视觉、径向/线性渐变、强阴影、粗体排版、列表与海报双形态。
import core.widgets;
import peek.home;

// Hero：使用真实 recommend 构建超高主视觉；没有推荐时 heroHeight=0，不产生占位。
// Item：grid/largeGrid 使用 Poster，list/textList 使用 RowCard。
// Header：分类横向滚动；右侧按钮调用壳子的分类选择、布局选择和刷新事件。

widget Hero = GestureDetector(
  onTap: event "openRecommend" { index: args.item.index },
  child: Container(
    margin: [ 8.0, 14.0 ],
    decoration: {
      type: "box",
      color: 0xFF090909,
      borderRadius: [ { x: 6.0 } ],
      border: [ { color: 0xFF7E1010, width: 1.0 } ],
      boxShadow: [ { color: 0xAA8F0000, blurRadius: 34.0, spreadRadius: 2.0 } ],
    },
    child: ClipRRect(
      borderRadius: [ { x: 6.0 } ],
      child: Stack(
        fit: "expand",
        children: [
          T4Image(url: args.item.pic),
          Container(
            decoration: {
              type: "box",
              gradient: {
                type: "linear",
                begin: { x: -1.0, y: 0.0 },
                end: { x: 1.0, y: 0.0 },
                colors: [ 0xF5000000, 0x99000000, 0x10000000 ],
              },
            },
          ),
          Align(
            alignment: { x: -1.0, y: 1.0 },
            child: Padding(
              padding: [ 24.0 ],
              child: Column(
                mainAxisSize: "min",
                crossAxisAlignment: "start",
                children: [
                  Text(
                    text: "NOW SHOWING",
                    maxLines: 1,
                    overflow: "ellipsis",
                    style: {
                      color: 0xFFE22B2B,
                      fontSize: 10.0,
                      fontWeight: "w800",
                      letterSpacing: 2.2,
                    },
                  ),
                  Padding(
                    padding: [ 0.0, 8.0, 0.0, 0.0 ],
                    child: Text(
                      text: args.item.name,
                      maxLines: 2,
                      overflow: "ellipsis",
                      style: {
                        color: 0xFFFFFFFF,
                        fontSize: 28.0,
                        fontWeight: "w900",
                      },
                    ),
                  ),
                  Padding(
                    padding: [ 0.0, 7.0, 0.0, 0.0 ],
                    child: Text(
                      text: args.item.remarks,
                      maxLines: 1,
                      overflow: "ellipsis",
                      style: {
                        color: 0xFFC8B8B8,
                        fontSize: 12.0,
                      },
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    ),
  ),
);

widget Tab = GestureDetector(
  onTap: event "selectType" { typeId: args.item.typeId },
  child: Container(
    margin: [ 0.0, 16.0, 7.0, 5.0 ],
    padding: [ 6.0, 6.0 ],
    decoration: {
      type: "box",
      color: switch args.item.selected { true: 0xFFE02020, false: 0xFF171717 },
      borderRadius: [ { x: 4.0 } ],
      border: [ { color: switch args.item.selected { true: 0xFFFF5A5A, false: 0xFF343434 }, width: 1.0 } ],
    },
    child: Text(
      text: args.item.typeName,
      style: {
        color: switch args.item.selected { true: 0xFFFFFFFF, false: 0xFFB7AFAF },
        fontSize: 13.0,
        fontWeight: "w800",
      },
    ),
  ),
);

widget TinyToolButton = GestureDetector(
  onTap: args.action,
  child: Container(
    width: 24.0,
    height: 28.0,
    alignment: { x: 0.0, y: 0.0 },
    child: Icon(icon: args.icon, fontFamily: "MaterialIcons", size: 17.0, color: 0xFFE24A4A),
  ),
);

widget Tool = GestureDetector(
  onTap: args.action,
  child: Container(
    width: 38.0,
    height: 38.0,
    margin: [ 2.0 ],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      color: 0xFF181818,
      borderRadius: [ { x: 4.0 } ],
      border: [ { color: 0xFF3B2424, width: 1.0 } ],
    },
    child: Icon(icon: args.icon, fontFamily: "MaterialIcons", size: 20.0, color: 0xFFE24A4A),
  ),
);

widget FilterOption = GestureDetector(
  onTap: event "selectFilter" { key: args.item.filterKey, value: args.item.value },
  child: Container(
    margin: [ 0.0, 8.0, 7.0, 8.0 ],
    padding: [ 10.0, 2.0 ],
    decoration: {
      type: "box",
      color: switch args.item.selected { true: 0xFFE02020, false: 0xFF171717 },
      borderRadius: [ { x: 3.0 } ],
      border: [ { color: switch args.item.selected { true: 0xFFFF5A5A, false: 0xFF3B2424 }, width: 1.0 } ],
    },
    child: Text(
      text: args.item.name,
      style: {
        color: switch args.item.selected { true: 0xFFFFFFFF, false: 0xFFB7AFAF },
        fontSize: 10.0,
        fontWeight: "w800",
      },
    ),
  ),
);

widget FilterRow = Row(
  children: [
    Expanded(
      child: ListView(
        scrollDirection: "horizontal",
        children: [ ...for option in args.group.options: FilterOption(item: option) ],
      ),
    ),
    switch args.group.canExpand {
      true: Tool(icon: data.home.icons.expand, action: event "showFilterPicker" { key: args.group.key }),
      false: SizedBoxShrink(),
    },
  ],
);

widget Poster = GestureDetector(
  onTap: event "openItem" { index: args.item.index },
  child: Container(
    decoration: {
      type: "box",
      color: 0xFF111111,
      borderRadius: [ { x: 5.0 } ],
      border: [ { color: 0xFF352020, width: 1.0 } ],
      boxShadow: [ { color: 0x55250000, blurRadius: 14.0 } ],
    },
    child: ClipRRect(
      borderRadius: [ { x: 5.0 } ],
      child: Stack(
        fit: "expand",
        children: [
          T4Image(url: args.item.pic),
          Container(
            decoration: {
              type: "box",
              gradient: {
                type: "linear",
                begin: { x: 0.0, y: -1.0 },
                end: { x: 0.0, y: 1.0 },
                colors: [ 0x00000000, 0x10000000, 0xEE000000 ],
              },
            },
          ),
          Align(
            alignment: { x: -1.0, y: 1.0 },
            child: Padding(
              padding: [ 12.0 ],
              child: Column(
                mainAxisSize: "min",
                crossAxisAlignment: "start",
                children: [
                  Text(
                    text: args.item.name,
                    maxLines: 1,
                    overflow: "ellipsis",
                    style: {
                      color: 0xFFFFFFFF,
                      fontSize: 14.0,
                      fontWeight: "w800",
                    },
                  ),
                  Padding(
                    padding: [ 0.0, 4.0, 0.0, 0.0 ],
                    child: Text(
                      text: args.item.remarks,
                      style: {
                        color: 0xFFE64B4B,
                        fontSize: 10.0,
                      },
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    ),
  ),
);

widget RowCard = GestureDetector(
  onTap: event "openItem" { index: args.item.index },
  child: Container(
    padding: [ 10.0 ],
    decoration: {
      type: "box",
      color: 0xFF121212,
      border: [ { color: 0xFF542020, width: 1.0 } ],
      borderRadius: [ { x: 4.0 } ],
    },
    child: Row(
      children: [
        Container(
          width: 118.0,
          child: ClipRRect(borderRadius: [ { x: 3.0 } ], child: T4Image(url: args.item.pic)),
        ),
        Expanded(
          child: Padding(
            padding: [ 14.0, 5.0 ],
            child: Column(
              mainAxisSize: "min",
              crossAxisAlignment: "start",
              children: [
                Text(
                  text: args.item.name,
                  maxLines: 1,
                  overflow: "ellipsis",
                  style: {
                    color: 0xFFFFFFFF,
                    fontSize: 17.0,
                    fontWeight: "w900",
                  },
                ),
                Text(
                  text: args.item.remarks,
                  maxLines: 1,
                  overflow: "ellipsis",
                  style: {
                    color: 0xFFDF4B4B,
                    fontSize: 10.0,
                  },
                ),
              ],
            ),
          ),
        ),
      ],
    ),
  ),
);

widget TextOnly = GestureDetector(
  onTap: event "openItem" { index: args.item.index },
  child: Container(
    padding: [ 16.0, 8.0 ],
    color: 0xFF111111,
    child: Row(
      children: [
        Container(
          width: 50.0,
          child: Text(
            text: args.item.rankLabel,
            style: {
              color: 0xFFE02020,
              fontSize: 20.0,
              fontWeight: "w900",
            },
          ),
        ),
        Expanded(
          child: Padding(
            padding: [ 12.0, 0.0 ],
            child: Text(
              text: args.item.name,
              maxLines: 1,
              overflow: "ellipsis",
              style: {
                color: 0xFFFFFFFF,
                fontSize: 15.0,
                fontWeight: "w800",
              },
            ),
          ),
        ),
        Text(
          text: args.item.remarks,
          maxLines: 1,
          overflow: "ellipsis",
          style: {
            color: 0xFF9B6B6B,
            fontSize: 10.0,
          },
        ),
      ],
    ),
  ),
);

widget Item = switch data.home.displayStyle {
  "grid": Poster(item: args.item),
  "largeGrid": Poster(item: args.item),
  "banner": Poster(item: args.item),
  "list": RowCard(item: args.item),
  "list2": RowCard(item: args.item),
  "textList": TextOnly(item: args.item),
  "card": RowCard(item: args.item),
  default: Poster(item: args.item),
};

widget SectionTitleSource = GestureDetector(
  onTap: event "showSourcePicker" {},
  child: Column(
    mainAxisSize: "min",
    crossAxisAlignment: "start",
    children: [
      Text(
        text: data.home.source.name,
        maxLines: 1,
        overflow: "ellipsis",
        style: {
          color: 0xFFFFFFFF,
          fontSize: 19.0,
          fontWeight: "w900",
        },
      ),
      Padding(
        padding: [ 0.0, 3.0, 0.0, 0.0 ],
        child: Text(
          text: [ data.home.totalLabel, " 部内容 · 点击站源名切换站源" ],
          maxLines: 1,
          overflow: "ellipsis",
          style: {
            color: 0xFFB7AFAF,
            fontSize: 10.0,
            letterSpacing: 0.4,
          },
        ),
      ),
    ],
  ),
);

widget SectionActionsCompact = Row(
  mainAxisAlignment: "end",
  children: [
    switch data.home.hasFilters {
      true: Padding(
        padding: [ 0.0, 0.0, 3.0, 0.0 ],
        child: TinyToolButton(
          icon: data.home.icons.filter,
          action: event "toggleFilters" {},
        ),
      ),
      false: SizedBoxShrink(),
    },
    Padding(
      padding: [ 0.0, 0.0, 3.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.api,
        action: event "showApiConfigPicker" {},
      ),
    ),
    Padding(
      padding: [ 0.0, 0.0, 3.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.search,
        action: event "openSearch" {},
      ),
    ),
    Padding(
      padding: [ 0.0, 0.0, 3.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.push,
        action: event "openPush" {},
      ),
    ),
    Padding(
      padding: [ 0.0, 0.0, 3.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.history,
        action: event "openHistory" {},
      ),
    ),
    Padding(
      padding: [ 0.0, 0.0, 3.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.favorite,
        action: event "openFavorite" {},
      ),
    ),
    Padding(
      padding: [ 0.0, 0.0, 3.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.layout,
        action: event "showDisplayStylePicker" {},
      ),
    ),
    TinyToolButton(
      icon: data.home.icons.refresh,
      action: event "refresh" {},
    ),
  ],
);

widget SectionActionsWide = Row(
  mainAxisAlignment: "end",
  children: [
    switch data.home.hasManyClasses {
      true: Padding(
        padding: [ 0.0, 0.0, 4.0, 0.0 ],
        child: TinyToolButton(
          icon: data.home.icons.expand,
          action: event "showCategoryPicker" {},
        ),
      ),
      false: SizedBoxShrink(),
    },
    switch data.home.hasFilters {
      true: Padding(
        padding: [ 0.0, 0.0, 4.0, 0.0 ],
        child: TinyToolButton(
          icon: data.home.icons.filter,
          action: event "toggleFilters" {},
        ),
      ),
      false: SizedBoxShrink(),
    },
    Padding(
      padding: [ 0.0, 0.0, 4.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.layout,
        action: event "showDisplayStylePicker" {},
      ),
    ),
    Padding(
      padding: [ 0.0, 0.0, 4.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.source,
        action: event "showSourcePicker" {},
      ),
    ),
    Padding(
      padding: [ 0.0, 0.0, 4.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.api,
        action: event "showApiConfigPicker" {},
      ),
    ),
    Padding(
      padding: [ 0.0, 0.0, 4.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.search,
        action: event "openSearch" {},
      ),
    ),
    Padding(
      padding: [ 0.0, 0.0, 4.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.push,
        action: event "openPush" {},
      ),
    ),
    Padding(
      padding: [ 0.0, 0.0, 4.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.history,
        action: event "openHistory" {},
      ),
    ),
    Padding(
      padding: [ 0.0, 0.0, 4.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.favorite,
        action: event "openFavorite" {},
      ),
    ),
    TinyToolButton(
      icon: data.home.icons.refresh,
      action: event "refresh" {},
    ),
  ],
);

widget SectionBar = Container(
  color: 0x00000000,
  padding: switch data.home.gridColumns {
    3: [ 16.0, 8.0, 16.0, 10.0 ],
    default: [ 20.0, 5.0, 20.0, 8.0 ],
  },
  child: Row(
    children: [
      Expanded(
        child: SectionTitleSource(),
      ),
      Container(
        width: switch data.home.isLandscape {
          true: 312.0,
          false: 214.0,
        },
        height: 28.0,
        child: switch data.home.isLandscape {
          true: SectionActionsWide(),
          false: SectionActionsCompact(),
        },
      ),
    ],
  ),
);

widget Header = Container(
  color: 0xFF080808,
  child: Column(
    children: [
      Container(
        height: 54.0,
        padding: [ 16.0, 0.0 ],
        child: Row(
          children: [
            Expanded(
              child: ListView(
                scrollDirection: "horizontal",
                children: [ ...for item in data.home.classes: Tab(item: item) ],
              ),
            ),
          ],
        ),
      ),
      switch data.home.showFilters {
        true: Container(
          height: data.home.filterPanelHeight,
          margin: [ 16.0, 4.0, 16.0, 6.0 ],
          padding: [ 10.0, 4.0 ],
          decoration: {
            type: "box",
            color: 0xFF111111,
            borderRadius: [ { x: 4.0 } ],
            border: [ { color: 0xFF542020, width: 1.0 } ],
            boxShadow: [ { color: 0x55250000, blurRadius: 14.0 } ],
          },
          child: ListView(
            children: [ ...for group in data.home.filters: Container(height: 39.0, child: FilterRow(group: group)) ],
          ),
        ),
        false: SizedBoxShrink(),
      },
    ],
  ),
);

widget root = Container(
  color: 0xFF080808,
  child: PeekStickyGrid(
    heroHeight: switch data.home.hasRecommend { true: 370.0, false: 0.0 },
    pinnedHeight: data.home.stickyHeaderHeight,
    sectionHeight: 55.0,
    crossAxisCount: switch data.home.displayStyle {
      "grid": data.home.gridColumns,
      "largeGrid": data.home.largeGridColumns,
      "banner": data.home.bannerColumns,
      "list": 1,
      "list2": 1,
      "textList": 1,
      "card": 1,
      default: data.home.gridColumns,
    },
    childAspectRatio: switch data.home.displayStyle {
      "grid": 0.62,
      "largeGrid": 0.62,
      "banner": 1.15,
      "list": data.home.wideListRatio,
      "list2": data.home.wideListRatio,
      "textList": data.home.textListRatio,
      "card": data.home.wideListRatio,
      default: 0.62,
    },
    hero: switch data.home.hasRecommend {
      true: PeekCarousel(
        autoPlay: true,
        interval: 6000,
        viewportFraction: 0.98,
        activeColor: 0xFFE02020,
        inactiveColor: 0x66888888,
        children: [ ...for item in data.home.home.recommend: Hero(item: item) ],
      ),
      false: SizedBoxShrink(),
    },
    pinnedHeader: Header(),
    sectionHeader: SectionBar(),
    empty: Center(child: Text(text: "NO SIGNAL", style: { color: 0xFFE02020 })),
    children: [ ...for item in data.home.items: Item(item: item) ],
  ),
);