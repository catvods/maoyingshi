// leecat-theme: {"id":"builtin-design-petal","name":"樱落春晓 · 玫瑰","description":"樱花横幅 · 花瓣形卡 · 粉白浅底","accent":"#e88aa0","backgroundColors":["#fdf0f2","#f5c6d0"],"cardRadius":16.0,"layout":"posters","hero":true,"floatingNavigation":true,"glassNavigation":false,"cinema":false,"liquidGlass":false,"designStyle":"petal","titleFont":"sans","surfaceColor":"#fff8fa","backgroundOpacity":0.06,"panelOpacity":0.72,"navigationOpacity":0.28,"nativeDesign":false}
// 樱落春晓 · 玫瑰 · 可编辑主题源码。颜色为 0xAARRGGBB，AA 控制透明度。
import core.widgets;
import peek.home;
widget Poster = GestureDetector(
 onTap: event "openItem" { index: args.item.index },
 child: Container(decoration: { type: "box", color: 0x66fdf0f2,
   borderRadius: [{ x: 28.0 }, { x: 8.0 }, { x: 28.0 }, { x: 8.0 }], border: [ { color: 0xffe88aa0, width: 1.0 } ] },
   child: ClipRRect(borderRadius: [{ x: 28.0 }, { x: 8.0 }, { x: 28.0 }, { x: 8.0 }], child: Stack(fit: "expand", children: [
     T4Image(url: args.item.pic),
     Align(alignment: {x: 0.0, y: 1.0}, child: PosterCaption(name: args.item.name, remarks: args.item.remarks))
   ]))
 ));
widget RowItem = GestureDetector(onTap: event "openItem" { index: args.item.index },
 child: Container(decoration: { type: "box", color: 0x66fdf0f2, borderRadius: [{ x: 28.0 }, { x: 8.0 }, { x: 28.0 }, { x: 8.0 }] },
 child: Row(children: [Container(width: 90.0, child: T4Image(url: args.item.pic)), Expanded(child: Padding(padding: [12.0], child: Column(mainAxisAlignment: "center", crossAxisAlignment: "start", children: [
 Text(text: args.item.name, maxLines: 1, overflow: "ellipsis", style: {color: 0xff252a30, fontSize: 16.0, fontWeight: "w700"}),
 Text(text: args.item.remarks, maxLines: 1, overflow: "ellipsis", style: {color: 0xff252a30, fontSize: 12.0})]))) ])));
widget TextItem = GestureDetector(onTap: event "openItem" {index: args.item.index}, child: Container(padding: [12.0, 8.0], color: 0x66fdf0f2, child: Row(children: [Expanded(child: Text(text: args.item.name, maxLines: 1, overflow: "ellipsis", style: {color: 0xff252a30, fontSize: 14.0})), Text(text: args.item.remarks, maxLines: 1, style: {color: 0xff252a30, fontSize: 11.0})])));
widget Item = switch data.home.displayStyle { "textList": TextItem(item: args.item), "list": RowItem(item: args.item), default: Poster(item: args.item) };
widget FilterGroup = Container(height: 39.0, child: Row(children: [
 Container(width: 58.0, alignment: {x: -1.0, y: 0.0}, padding: [8.0, 0.0], child: Text(text: args.group.name, maxLines: 1, overflow: "ellipsis", style: {color: 0xff252a30, fontSize: 12.0})),
 Expanded(child: ListView(scrollDirection: "horizontal", children: [
 ...for option in args.group.options: GestureDetector(onTap: event "selectFilter" {key: option.filterKey, value: option.value}, child: Container(alignment: {x: 0.0, y: 0.0}, margin: [4.0], padding: [10.0, 4.0],
 decoration: {type: "box", color: switch option.selected {true: 0x55e88aa0, false: 0x33fdf0f2}, borderRadius: [{ x: 28.0 }, { x: 8.0 }, { x: 28.0 }, { x: 8.0 }]}, child: Text(text: option.name, textAlign: "center", maxLines: 1, style: {color: 0xff252a30, fontSize: 12.0})))
]))]));
widget Header = Column(children: [
 Container(height: 54.0, child: ListView(scrollDirection: "horizontal", children: [...for item in data.home.classes: Tab(item: item)])),
 switch data.home.hasFilters {true: switch data.home.showFilters {true: Container(height: data.home.filterPanelHeight, margin: [0.0, 4.0, 0.0, 6.0], child: ListView(children: [...for group in data.home.filters: FilterGroup(group: group)])), false: SizedBoxShrink()}, false: SizedBoxShrink()}
]);
widget Tab = GestureDetector(onTap: event "selectType" { typeId: args.item.typeId },
 child: Container(alignment: {x: 0.0, y: 0.0}, margin: [ 4.0 ], padding: [ 12.0, 8.0 ], decoration: { type: "box",
 color: switch args.item.selected { true: 0x55e88aa0, false: 0x33fdf0f2 }, borderRadius: [{ x: 28.0 }, { x: 8.0 }, { x: 28.0 }, { x: 8.0 }] },
 child: Text(text: args.item.typeName, textAlign: "center", maxLines: 1, style: { color: 0xff252a30, fontSize: 14.0 })));
widget root = PeekStickyGrid(
 heroHeight: switch data.home.hasRecommend { true: data.home.heroHeight, false: 0.0 },
 pinnedHeight: data.home.stickyHeaderHeight, sectionHeight: 0.0,
 crossAxisCount: switch data.home.displayStyle {"textList": 1, "list": 1, "largeGrid": data.home.largeGridColumns, "banner": data.home.bannerColumns, default: 3}, childAspectRatio: switch data.home.displayStyle {"textList": data.home.textListRatio, "list": data.home.wideListRatio, "banner": 1.5, default: 0.72},
 horizontalPadding: 12.0, mainAxisSpacing: 14.0, crossAxisSpacing: 12.0, bottomPadding: 24.0,
 hero: PeekCarousel(autoPlay: true, interval: 5000, viewportFraction: 0.94,
 children: [...for item in data.home.home.recommend: GestureDetector(
 onTap: event "openRecommend" { index: item.index }, child: Stack(fit: "expand", children: [
 T4Image(url: item.pic),     Align(alignment: {x: 0.85, y: -0.8}, child: Container(width: 26.0, height: 26.0, decoration: { type: "box", color: 0xCCE88AA0, borderRadius: [ { x: 13.0 } ] })),
     Align(alignment: {x: -0.8, y: -0.7}, child: Container(width: 18.0, height: 18.0, decoration: { type: "box", color: 0x99F5C6D0, borderRadius: [ { x: 9.0 } ] })),
 Align(alignment: { x: 0.0, y: 1.0 }, child: Container(color: 0x99000000,
 padding: [ 16.0 ], child: Row(children: [Expanded(child: Text(text: item.name, maxLines: 1, overflow: "ellipsis", style: { color: 0xFFFFFFFF, fontSize: 20.0 }))])))
 ]))]),
 pinnedHeader: Header(),
 sectionHeader: SizedBoxShrink(), empty: Center(child: Text(text: "暂无内容", style: { color: 0xff252a30 })),
 children: [...for item in data.home.items: Item(item: item)]
);
