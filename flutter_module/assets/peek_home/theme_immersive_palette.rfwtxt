widget ThemeItem = switch data.home.displayStyle {
  "banner": FeatureBanner(item: args.item),
  "list": ListCard(item: args.item),
  "list2": CompactCard(item: args.item),
  "textList": TextCard(item: args.item),
  "card": WideCard(item: args.item),
  default: PosterCard(item: args.item),
};

widget EmptyState = switch data.home.loading {
  true: Center(
    child: Text(
      text: "正在载入…",
      style: { color: 0xD9FFFFFF, fontSize: 13.0 },
    ),
  ),
  false: switch data.home.errorMessage {
    "": Center(
      child: Text(
        text: "暂无内容",
        style: { color: 0xC8FFFFFF, fontSize: 13.0 },
      ),
    ),
    default: GestureDetector(
      onTap: event "refresh" {},
      child: Center(
        child: Text(
          text: data.home.errorMessage,
          maxLines: 2,
          overflow: "ellipsis",
          textAlign: "center",
          style: { color: 0xE6FFFFFF, fontSize: 12.0, height: 1.25 },
        ),
      ),
    ),
  },
};

widget root = Container(
  color: data.home.immersive.backgroundColor,
  child: Stack(
    fit: "expand",
    children: [
      PeekImmersiveBackdrop(
        imageUrl: data.home.immersive.imageUrl,
        primaryColor: data.home.immersive.primaryColor,
        secondaryColor: data.home.immersive.secondaryColor,
        backgroundColor: data.home.immersive.backgroundColor,
      ),
      PeekStickyGrid(
        heroHeight: switch data.home.hasRecommend {
          true: switch data.home.gridColumns {
            3: 272.0,
            4: 338.0,
            5: 372.0,
            6: 404.0,
            default: 272.0,
          },
          false: 0.0,
        },
        pinnedHeight: data.home.immersiveStickyHeaderHeight,
        sectionHeight: switch data.home.gridColumns {
          3: 70.0,
          default: 64.0,
        },
        crossAxisCount: switch data.home.displayStyle {
          "grid": data.home.gridColumns,
          "largeGrid": data.home.largeGridColumns,
          "banner": data.home.bannerColumns,
          "list": 1,
          "list2": 1,
          "textList": 1,
          "card": 1,
          default: data.home.gridColumns,
        },
        childAspectRatio: switch data.home.displayStyle {
          "grid": 0.75,
          "largeGrid": 0.75,
          "banner": 0.78,
          "list": switch data.home.gridColumns {
            3: 3.2,
            default: data.home.wideListRatio,
          },
          "list2": data.home.wideListRatio,
          "textList": data.home.textListRatio,
          "card": switch data.home.gridColumns {
            3: 2.9,
            4: 4.8,
            5: 5.6,
            default: 6.2,
          },
          default: 0.75,
        },
        mainAxisSpacing: 12.0,
        crossAxisSpacing: 10.0,
        horizontalPadding: switch data.home.gridColumns {
          3: 16.0,
          default: 20.0,
        },
        bottomPadding: 106.0,
        hero: switch data.home.hasRecommend {
          true: PeekImmersiveHero(
            imageUrl: data.home.immersive.imageUrl,
            primaryColor: data.home.immersive.primaryColor,
            secondaryColor: data.home.immersive.secondaryColor,
            backgroundColor: data.home.immersive.backgroundColor,
            fit: "cover",
            portraitFit: "cover",
            landscapeFit: "cover",
            portraitAlignment: "topCenter",
            landscapeAlignment: "center",
            child: Stack(
              fit: "expand",
              children: [
                PeekCarousel(
                  autoPlay: true,
                  style: "standard",
                  showIndicators: true,
                  indicatorAlignment: switch data.home.gridColumns {
                    3: "center",
                    default: "end",
                  },
                  syncImmersivePalette: true,
                  interval: 5200,
                  viewportFraction: 1.0,
                  activeColor: 0xFFFFFFFF,
                  inactiveColor: 0x55FFFFFF,
                  children: [
                    ...for item in data.home.home.recommend:
                      HeroTapLayer(item: item),
                  ],
                ),
                HeroMeta(item: data.home.immersive.active),
              ],
            ),
          ),
          false: SizedBoxShrink(),
        },
        pinnedHeader: CategoryHeader(),
        sectionHeader: SectionBar(),
        empty: EmptyState(),
        children: [
          ...for item in data.home.items:
            ThemeItem(item: item),
        ],
      ),
    ],
  ),
);
