widget FeatureBanner = GestureDetector(
  onTap: event "openItem" { index: args.item.index },
  onLongPress: event "longPressItem" { index: args.item.index },
  child: Container(
    decoration: {
      type: "box",
      borderRadius: [ { x: 22.0 } ],
      boxShadow: [ { color: 0x2611161B, blurRadius: 16.0, offset: { x: 0.0, y: 10.0 } } ],
    },
    child: ClipRRect(
      borderRadius: [ { x: 22.0 } ],
      child: Stack(
        fit: "expand",
        children: [
          T4Image(url: args.item.pic),
          Container(
            decoration: {
              type: "box",
              gradient: {
                type: "linear",
                begin: { x: -0.7, y: 0.1 },
