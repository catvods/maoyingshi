widget HeroMeta = switch data.home.gridColumns {
  3: HeroMetaPortrait(item: args.item),
  default: HeroMetaLandscape(item: args.item),
};

widget CategoryChip = GestureDetector(
  onTap: event "selectType" { typeId: args.item.typeId },
  child: PeekGlass(
    blur: 14.0,
    radius: 18.0,
    tintColor: switch args.item.selected {
      true: 0xD9FFFFFF,
      false: 0x1EFFFFFF,
    },
    borderColor: switch args.item.selected {
      true: 0x40FFFFFF,
      false: 0x18FFFFFF,
    },
    child: Container(
      height: 30.0,
      padding: [ 14.0, 0.0 ],
      alignment: { x: 0.0, y: 0.0 },
      child: Text(
        text: args.item.typeName,
        maxLines: 1,
        overflow: "ellipsis",
        style: {
          color: switch args.item.selected {
            true: 0xFF221A17,
            false: 0xF5FFFFFF,
          },
          fontSize: 12.0,
          fontWeight: "w800",
          height: 1.0,
        },
      ),
    ),
  ),
);

widget ToolButton = GestureDetector(
  onTap: args.action,
  child: PeekGlass(
    blur: 14.0,
    radius: 13.0,
    tintColor: 0x20FFFFFF,
    borderColor: 0x1EFFFFFF,
    child: Container(
      width: 26.0,
      height: 26.0,
      alignment: { x: 0.0, y: 0.0 },
      child: Icon(
        icon: args.icon,
        fontFamily: "MaterialIcons",
        size: 14.0,
        color: 0xF7FFFFFF,
      ),
    ),
  ),
);

widget TinyToolButton = GestureDetector(
  onTap: args.action,
  child: PeekGlass(
    blur: 14.0,
    radius: 12.0,
    tintColor: 0x20FFFFFF,
    borderColor: 0x1EFFFFFF,
    child: Container(
      width: 23.0,
      height: 26.0,
