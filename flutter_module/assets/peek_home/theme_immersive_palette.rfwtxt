// 沉浸光影：参考 TMDB 详情页主视觉，顶部 Hero 独立承载海报与取色。
import core.widgets;
import peek.home;

widget HeroTapLayer = GestureDetector(
  onTap: event "openRecommend" { index: args.item.index },
  child: Container(color: 0x00000000),
);

widget HeroLogoPlate = Padding(
  padding: [ 2.0, 1.0 ],
  child: T4Image(
    url: args.url,
    fit: "contain",
    alignment: args.alignment,
    placeholderColor: 0x00000000,
    useOldImageOnUrlChange: true,
  ),
);

widget HeroTitlePortrait = switch args.item.titleLogo {
  "": Text(
    text: args.item.name,
    maxLines: 2,
    overflow: "ellipsis",
    textAlign: "center",
    style: {
      color: 0xFFFFFFFF,
      fontSize: 28.0,
      fontWeight: "w900",
      height: 1.02,
      shadows: [
        { color: 0xAA000000, blurRadius: 12.0 },
        { color: 0x66000000, blurRadius: 28.0 },
      ],
    },
  ),
  default: Container(
    height: 72.0,
    constraints: { maxWidth: 292.0 },
    child: HeroLogoPlate(
      url: args.item.titleLogo,
      alignment: "center",
    ),
  ),
};

widget HeroTitleLandscape = switch args.item.titleLogo {
  "": Text(
    text: args.item.name,
    maxLines: 2,
    overflow: "ellipsis",
    textAlign: "left",
    style: {
      color: 0xFFFFFFFF,
      fontSize: 25.0,
      fontWeight: "w900",
      height: 1.02,
      shadows: [
        { color: 0xAA000000, blurRadius: 12.0 },
        { color: 0x66000000, blurRadius: 28.0 },
      ],
    },
  ),
  default: Container(
    height: 60.0,
    constraints: { maxWidth: 360.0 },
    alignment: { x: -1.0, y: 1.0 },
    child: HeroLogoPlate(
      url: args.item.titleLogo,
      alignment: "centerLeft",
    ),
  ),
};

widget HeroMetaPortrait = Align(
  alignment: { x: 0.0, y: 1.0 },
  child: Padding(
    padding: [ 22.0, 0.0, 22.0, 30.0 ],
    child: Column(
      mainAxisSize: "min",
      crossAxisAlignment: "center",
      children: [
        switch args.item.year {
          "": switch args.item.typeName {
            "": SizedBoxShrink(),
            default: Container(
              padding: [ 12.0, 5.0 ],
              decoration: {
                type: "box",
                color: 0x2BFFFFFF,
                borderRadius: [ { x: 16.0 } ],
                border: [ { color: 0x30FFFFFF, width: 1.0 } ],
              },
              child: Text(
                text: args.item.typeName,
                maxLines: 1,
                overflow: "ellipsis",
                style: {
                  color: 0xF5FFFFFF,
                  fontSize: 11.0,
                  fontWeight: "w700",
                  letterSpacing: 0.8,
                },
              ),
            ),
          },
          default: Container(
            padding: [ 12.0, 5.0 ],
            decoration: {
              type: "box",
              color: 0x2BFFFFFF,
              borderRadius: [ { x: 16.0 } ],
              border: [ { color: 0x30FFFFFF, width: 1.0 } ],
            },
            child: Text(
              text: switch args.item.typeName {
                "": args.item.year,
                default: [ args.item.year, " / ", args.item.typeName ],
              },
              maxLines: 1,
              overflow: "ellipsis",
              style: {
                color: 0xF5FFFFFF,
                fontSize: 11.0,
                fontWeight: "w700",
                letterSpacing: 0.8,
              },
            ),
          ),
        },
        Padding(
          padding: [ 0.0, 10.0, 0.0, 0.0 ],
          child: HeroTitlePortrait(item: args.item),
        ),
        switch args.item.remarks {
          "": SizedBoxShrink(),
          default: Padding(
            padding: [ 0.0, 8.0, 0.0, 0.0 ],
            child: Text(
              text: args.item.remarks,
              maxLines: 3,
              overflow: "ellipsis",
              textAlign: "center",
              style: {
                color: 0xEBFFFFFF,
                fontSize: 13.0,
                height: 1.22,
                shadows: [ { color: 0x88000000, blurRadius: 10.0 } ],
              },
            ),
          ),
        },
      ],
    ),
  ),
);

