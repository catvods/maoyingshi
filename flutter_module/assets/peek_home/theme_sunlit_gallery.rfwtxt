);

widget PosterCard = GestureDetector(
  onTap: event "openItem" { index: args.item.index },
  onLongPress: event "longPressItem" { index: args.item.index },
  child: Container(
    decoration: {
      type: "box",
      color: 0xFFFFFFFF,
      borderRadius: [ { x: 17.0 } ],
      border: [ { color: 0xFFDCC9B8, width: 1.0 } ],
      boxShadow: [ { color: 0x245F4A3F, blurRadius: 15.0, offset: { x: 0.0, y: 8.0 } } ],
    },
    child: ClipRRect(
      borderRadius: [ { x: 17.0 } ],
      child: Stack(
        fit: "expand",
        children: [
          T4Image(url: args.item.pic),
          Container(
            decoration: {
              type: "box",
              gradient: {
                type: "linear",
                begin: { x: 0.0, y: -1.0 },
                end: { x: 0.0, y: 1.0 },
                colors: [ 0x00000000, 0x05000000, 0xC946342B ],
              },
            },
          ),
          Align(
            alignment: { x: -1.0, y: 1.0 },
            child: Padding(
              padding: [ 12.0, 12.0, 12.0, 13.0 ],
              child: Column(
                mainAxisSize: "min",
                crossAxisAlignment: "start",
                children: [
                  Text(
                    text: args.item.name,
                    maxLines: 2,
                    overflow: "ellipsis",
                    style: { color: 0xFFFFFFFF, fontSize: 13.0, fontWeight: "w900", height: 1.05 },
                  ),
                  switch args.item.remarks {
                    "": SizedBoxShrink(),
                    default: Padding(
                      padding: [ 0.0, 5.0, 0.0, 0.0 ],
                      child: Text(
                        text: args.item.remarks,
                        maxLines: 1,
                        overflow: "ellipsis",
                        style: { color: 0xFFF4E7DB, fontSize: 9.0, fontWeight: "w600" },
                      ),
                    ),
                  },
                ],
              ),
            ),
          ),
        ],
      ),
    ),
  ),
);

