      Padding(
        padding: [ 0.0, 3.0, 0.0, 0.0 ],
        child: Text(
          text: [ data.home.totalLabel, " 部内容 · 点击站源名切换站源" ],
          maxLines: 1,
          overflow: "ellipsis",
          style: { color: 0xFF8E7C71, fontSize: 10.0, letterSpacing: 0.4 },
        ),
      ),
    ],
  ),
);

widget TinyToolButton = GestureDetector(
  onTap: args.action,
  child: Container(
    width: 24.0,
    height: 28.0,
    alignment: { x: 0.0, y: 0.0 },
