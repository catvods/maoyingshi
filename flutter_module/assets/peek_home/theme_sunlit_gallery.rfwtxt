// 暖阳影廊：明亮暖色的竖版层叠轮播主题。
// 手机主卡更窄，让左右层叠卡更容易被看见。
// 轮播海报不叠加标签、排名或装饰文字。
import core.widgets;
import peek.home;

widget HeroPoster = GestureDetector(
  onTap: event "openRecommend" { index: args.item.index },
  child: Center(
    child: AspectRatio(
      aspectRatio: switch data.home.gridColumns {
        3: 0.56,
        4: 0.62,
        5: 0.68,
        6: 0.70,
        default: 0.56,
      },
      child: Container(
        margin: [ 8.0, 10.0 ],
        decoration: {
          type: "box",
          color: 0xFFFFFFFF,
          borderRadius: [ { x: 24.0 } ],
          border: [ { color: 0x99D4B694, width: 1.0 } ],
          boxShadow: [
            { color: 0x4D5D4B40, blurRadius: 28.0, offset: { x: 0.0, y: 16.0 }, spreadRadius: 1.0 },
            { color: 0x33B87558, blurRadius: 18.0, offset: { x: 0.0, y: 5.0 } },
          ],
        },
        child: ClipRRect(
          borderRadius: [ { x: 24.0 } ],
          child: T4Image(url: args.item.pic),
        ),
      ),
    ),
  ),
);

widget CategoryChip = GestureDetector(
  onTap: event "selectType" { typeId: args.item.typeId },
  child: Container(
    height: 42.0,
    margin: [ 0.0, 8.0, 8.0, 8.0 ],
    padding: [ 14.0, 0.0 ],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      gradient: switch args.item.selected {
        true: {
          type: "linear",
          begin: { x: -1.0, y: -1.0 },
          end: { x: 1.0, y: 1.0 },
          colors: [ 0xFFD8B07C, 0xFFB87558 ],
        },
        false: {
          type: "linear",
          colors: [ 0xFFFFFFFF, 0xFFF5F0E8 ],
        },
      },
      borderRadius: [ { x: 18.0 } ],
      border: [
        {
          color: switch args.item.selected { true: 0xFFE1C6A4, false: 0xFFDDD1C5 },
          width: 1.0,
        },
      ],
      boxShadow: switch args.item.selected {
        true: [ { color: 0x3DB87558, blurRadius: 14.0, offset: { x: 0.0, y: 5.0 } } ],
        false: [ { color: 0x1F6B5A50, blurRadius: 8.0, offset: { x: 0.0, y: 3.0 } } ],
      },
    },
    child: Text(
      text: args.item.typeName,
      maxLines: 1,
      overflow: "ellipsis",
      style: {
        color: switch args.item.selected { true: 0xFFFFFFFF, false: 0xFF75665D },
        fontSize: 14.0,
        fontWeight: "w900",
        height: 1.0,
      },
    ),
  ),
);

widget ToolButton = GestureDetector(
  onTap: args.action,
  child: Container(
    width: 36.0,
    height: 36.0,
    margin: [ 5.0, 0.0, 0.0, 0.0 ],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      gradient: {
        type: "linear",
        begin: { x: -1.0, y: -1.0 },
        end: { x: 1.0, y: 1.0 },
        colors: [ 0xFFFFFFFF, 0xFFF2E9DE ],
      },
      borderRadius: [ { x: 18.0 } ],
      border: [ { color: 0xFFD9C6B5, width: 1.0 } ],
      boxShadow: [ { color: 0x246B5549, blurRadius: 10.0, offset: { x: 0.0, y: 5.0 } } ],
    },
    child: Icon(
      icon: args.icon,
      fontFamily: "MaterialIcons",
      size: 18.0,
      color: 0xFFA9654B,
    ),
  ),
);

widget FilterOption = GestureDetector(
  onTap: event "selectFilter" { key: args.item.filterKey, value: args.item.value },
  child: Container(
    height: 30.0,
    margin: [ 0.0, 8.0, 7.0, 8.0 ],
    padding: [ 10.0, 2.0 ],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      color: switch args.item.selected { true: 0xFFB87558, false: 0xFFFFFFFF },
      borderRadius: [ { x: 13.0 } ],
      border: [
        {
          color: switch args.item.selected { true: 0xFFC98B68, false: 0xFFDED0C3 },
          width: 1.0,
        },
      ],
    },
    child: Text(
      text: args.item.name,
      maxLines: 1,
      overflow: "ellipsis",
      style: {
        color: switch args.item.selected { true: 0xFFFFFFFF, false: 0xFF7B6A60 },
        fontSize: 12.0,
        fontWeight: "w800",
        height: 1.0,
      },
    ),
  ),
);

widget FilterRow = Row(
  children: [
    Expanded(
      child: ListView(
        scrollDirection: "horizontal",
        children: [
          ...for option in args.group.options:
            FilterOption(item: option),
        ],
      ),
    ),
    switch args.group.canExpand {
      true: ToolButton(
        icon: data.home.icons.expand,
        action: event "showFilterPicker" { key: args.group.key },
      ),
      false: SizedBoxShrink(),
    },
  ],
);

widget CategoryHeader = Container(
  decoration: {
    type: "box",
    color: 0xFAF7F3ED,
    boxShadow: [ { color: 0x286B574C, blurRadius: 16.0, offset: { x: 0.0, y: 8.0 } } ],
  },
  child: Column(
    children: [
      Container(
        height: 54.0,
        padding: [ 14.0, 0.0 ],
        child: ListView(
          scrollDirection: "horizontal",
          children: [
            ...for item in data.home.classes:
              CategoryChip(item: item),
          ],
        ),
      ),
      switch data.home.showFilters {
        true: Container(
          height: data.home.filterPanelHeight,
          margin: [ 14.0, 4.0, 14.0, 6.0 ],
          padding: [ 10.0, 4.0 ],
          decoration: {
            type: "box",
            gradient: {
              type: "linear",
              begin: { x: -1.0, y: -1.0 },
              end: { x: 1.0, y: 1.0 },
              colors: [ 0xFFFFFFFF, 0xFFF4ECE2 ],
            },
            borderRadius: [ { x: 16.0 } ],
            border: [ { color: 0xFFDBC7B5, width: 1.0 } ],
            boxShadow: [ { color: 0x246C574B, blurRadius: 14.0 } ],
          },
          child: ListView(
            children: [
              ...for group in data.home.filters:
                Container(height: 39.0, child: FilterRow(group: group)),
            ],
          ),
        ),
        false: SizedBoxShrink(),
      },
    ],
  ),
);

widget SectionTitleSource = GestureDetector(
  onTap: event "showSourcePicker" {},
  child: Column(
    mainAxisSize: "min",
    crossAxisAlignment: "start",
    children: [
      Text(
        text: data.home.source.name,
        maxLines: 1,
        overflow: "ellipsis",
