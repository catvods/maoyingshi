widget SectionBar = Container(
  color: 0x00000000,
  padding: switch data.home.gridColumns {
    3: [ 16.0, 8.0, 16.0, 10.0 ],
    default: [ 20.0, 5.0, 20.0, 8.0 ],
  },
  child: Row(
    children: [
      Expanded(
        child: SectionTitleSource(),
      ),
      Container(
        width: switch data.home.isLandscape {
          true: 312.0,
          false: 214.0,
        },
        height: 28.0,
        child: switch data.home.isLandscape {
          true: SectionActionsWide(),
          false: SectionActionsCompact(),
        },
      ),
    ],
  ),
);

widget Header = Container(color: 0xFF030704, child: Column(children: [ Container(height: 54.0, padding: [ 10.0, 0.0 ], child: Row(children: [ Expanded(child: ListView(scrollDirection: "horizontal", children: [ ...for item in data.home.classes: Command(item: item) ])) ])), switch data.home.showFilters { true: Container(height: data.home.filterPanelHeight, margin: [ 10.0, 4.0, 10.0, 6.0 ], padding: [ 10.0, 4.0 ], decoration: { type: "box", color: 0xFF071109, border: [ { color: 0xFF174A21, width: 1.0 } ], boxShadow: [ { color: 0x332DFF55, blurRadius: 10.0 } ] }, child: ListView(children: [ ...for group in data.home.filters: Container(height: 39.0, child: FilterRow(group: group)) ])), false: SizedBoxShrink() } ]));

widget root = Container(color: 0xFF030704, child: PeekStickyGrid(heroHeight: 0.0, pinnedHeight: data.home.stickyHeaderHeight, sectionHeight: 55.0, crossAxisCount: switch data.home.displayStyle { "grid": data.home.gridColumns, "largeGrid": data.home.largeGridColumns, "banner": data.home.bannerColumns, "list": 1, "list2": 1, "textList": 1, "card": 1, default: 1 }, childAspectRatio: switch data.home.displayStyle { "grid": 0.62, "largeGrid": 0.62, "banner": 1.05, "list": data.home.textListRatio, "list2": data.home.textListRatio, "textList": data.home.textListRatio, "card": data.home.wideListRatio, default: data.home.textListRatio }, hero: SizedBoxShrink(), pinnedHeader: Header(), sectionHeader: SectionBar(), empty: Center(child: Text(text: "[ EMPTY RESULT ]", style: { color: 0xFF57FF7A, fontFamily: "monospace" })), children: [ ...for item in data.home.items: Item(item: item) ]));
